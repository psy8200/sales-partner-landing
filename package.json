{
  "name": "sales-partner-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:reset": "taskkill /f /im node.exe && npx prisma generate && npm run dev",
    "prisma:sync": "npx prisma db push && npx prisma generate",
    "prisma:studio": "npx prisma studio",
    "prisma:health": "npx tsx scripts/prisma-health-check.ts",
    "backup": "npx tsx scripts/manual-backup.ts",
    "restore": "npx tsx scripts/manual-restore.ts",
    "backup:status": "npx tsx scripts/backup-status.ts",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File scripts/dev-cleanup.ps1",
    "dev:start": "npm run dev:clean && npm run dev",
    "dev:port3000": "powershell -Command \"Start-Process powershell -ArgumentList '-NoExit', '-Command', 'cd C:\\home\\sales-partner-landing; npm run dev' -Verb RunAs\"",
    "check:data": "npx tsx scripts/check-all-data.ts",
    "check:users": "npx tsx scripts/check-users-detail.ts",
    "check:contracts": "npx tsx scripts/check-contracts.ts",
    "check:items": "npx tsx scripts/check-items.ts",
    "check:admin": "npx tsx scripts/check-super-admin.ts",
    "test:fields": "npx tsx scripts/test-contract-fields.ts",
    "fix:encoding": "powershell -ExecutionPolicy Bypass -File scripts/fix-encoding-issue.ps1"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.8.0",
    "@neondatabase/serverless": "^1.0.1",
    "@prisma/client": "^6.15.0",
    "@stripe/stripe-js": "^7.6.1",
    "@types/ws": "^8.18.1",
    "@upstash/redis": "^1.35.1",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^12.23.9",
    "lucide-react": "^0.542.0",
    "next": "15.4.3",
    "next-themes": "^0.4.6",
    "prisma": "^6.15.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^18.3.0",
    "ws": "^8.18.3",
    "xlsx": "^0.18.5",
    "zod": "^4.1.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.13",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/stripe": "^8.0.416",
    "autoprefixer": "^10.4.14",
    "eslint": "^9",
    "eslint-config-next": "15.4.3",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.2",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
